<Page x:Class="Afterhours.Uno.Views.ChartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:conv="using:Afterhours.Uno.Converters"
      Background="{StaticResource SurfacePanelBrush}" Width="{utu:Responsive Narrowest=360, Narrow=480}">
  <!-- The shared stage's weekly chart. Opened with !Chart from the shared stage. -->
  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="ShownWhen" />
    <conv:BoolToBrushConverter x:Key="OwnRow" TrueBrush="{StaticResource SurfaceAccentTintBrush}" FalseBrush="{StaticResource SurfaceRaisedBrush}" />
    <DataTemplate x:Key="RowTemplate">
      <Grid ColumnSpacing="12" Padding="12,8" Margin="0,0,0,6" CornerRadius="{StaticResource ChipRadius}"
            Background="{Binding Own, Converter={StaticResource OwnRow}}" AutomationProperties.Name="{Binding}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Mark}" Style="{StaticResource NumeralText}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" />
          <TextBlock Text="{Binding Artist}" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" VerticalAlignment="Center">
          <Run Text="{Binding Listeners}" /><Run Text=" ♡" />
        </TextBlock>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <ScrollViewer>
    <StackPanel Padding="24" Spacing="12">
      <TextBlock Text="{Binding Chart.Week}" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
      <TextBlock Text="This week’s chart" Style="{StaticResource TitleText}" />
      <mvux:FeedView Source="{Binding Top}" HorizontalContentAlignment="Stretch">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Data}" ItemTemplate="{StaticResource RowTemplate}" />
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
        <mvux:FeedView.NoneTemplate>
          <DataTemplate>
            <TextBlock Text="No applause yet this week. Play a set and the chart opens." Style="{StaticResource BodyText}" TextWrapping="Wrap" />
          </DataTemplate>
        </mvux:FeedView.NoneTemplate>
      </mvux:FeedView>
      <StackPanel Spacing="8" Visibility="{Binding HasLast, Converter={StaticResource ShownWhen}}">
        <TextBlock Text="Last week" Style="{StaticResource BodyStrongText}" />
        <ItemsControl ItemsSource="{Binding Last}" ItemTemplate="{StaticResource RowTemplate}" />
      </StackPanel>
      <TextBlock Text="Ranked by how many different listeners applauded a track this week. The top three earn 150, 100 and 60 ✦."
                 Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
      <Button Content="Back to the stage" Style="{StaticResource SoftButtonStyle}" Command="{Binding Back}" />
    </StackPanel>
  </ScrollViewer>
</Page>
