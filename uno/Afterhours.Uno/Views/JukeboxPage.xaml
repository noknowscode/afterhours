<Page x:Class="Afterhours.Uno.Views.JukeboxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      Background="{StaticResource SurfacePanelBrush}" Width="{utu:Responsive Narrowest=340, Narrow=440}">
  <!-- The current room's playlist. Opened with !Jukebox (room tools, jukebox and speaker pieces). -->
  <StackPanel Padding="24" Spacing="12">
    <TextBlock Text="ROOM JUKEBOX" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
    <TextBlock Text="The room has a soundtrack" Style="{StaticResource TitleText}" />
    <TextBlock Text="Select songs for this room. The jukebox plays them in order." Style="{StaticResource BodyText}"
               TextWrapping="Wrap" TextTrimming="None" />
    <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding Error}" />
    <mvux:FeedView Source="{Binding Options}" HorizontalContentAlignment="Stretch">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ItemsControl ItemsSource="{Binding Data}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Chosen}" Margin="0,0,0,4" AutomationProperties.Name="{Binding Title}" CommandParameter="{Binding}"
                          Command="{utu:AncestorBinding AncestorType=mvux:FeedView, Path=DataContext.Toggle}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>
      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <TextBlock Text="Save your first track in the studio to build a playlist." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>
    </mvux:FeedView>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Save playlist" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Save}" />
      <Button Content="▶ Play playlist" Style="{StaticResource SoftButtonStyle}" Command="{Binding PlayAll}" />
    </StackPanel>
  </StackPanel>
</Page>
