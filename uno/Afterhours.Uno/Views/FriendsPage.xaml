<Page x:Class="Afterhours.Uno.Views.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:conv="using:Afterhours.Uno.Converters"
      Background="{StaticResource SurfacePanelBrush}" Width="{utu:Responsive Narrowest=360, Narrow=480}">
  <!-- Your circle and connected friends. Opened with !Friends (the chat column's Friends, the shared world). -->
  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="ShownWhen" />
  </Page.Resources>
  <ScrollViewer>
    <StackPanel Padding="24" Spacing="12">
      <TextBlock Text="YOUR CIRCLE" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
      <TextBlock Text="Good company" Style="{StaticResource TitleText}" />
      <TextBlock Text="Your resident circle lives on this device. Connected players appear below when you join a shared session."
                 Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
      <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding Error}" />
      <TextBlock Text="Click a resident in a room to add them to your circle." Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                 Visibility="{Binding NoCircle, Converter={StaticResource ShownWhen}}" />
      <ItemsControl ItemsSource="{Binding Circle}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="0,0,0,6" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SoftButtonStyle}"
                    AutomationProperties.Name="{Binding}" CommandParameter="{Binding}" Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.View}">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="♡" Foreground="{StaticResource AcidBrush}" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                  <TextBlock Text="Resident character" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="View ↗" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="8" Visibility="{Binding Connected, Converter={StaticResource ShownWhen}}">
        <TextBlock Text="Connected friends" Style="{StaticResource BodyStrongText}" />
        <TextBlock Text="Click a connected player to send a friend request." Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Visibility="{Binding NoFriends, Converter={StaticResource ShownWhen}}" />
        <ItemsControl ItemsSource="{Binding Requests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,6" Padding="12,8" ColumnSpacing="8" CornerRadius="{StaticResource ChipRadius}" Background="{StaticResource SurfaceRaisedBrush}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                  <TextBlock Text="Wants to be friends" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Accept" Style="{StaticResource PrimaryButtonStyle}" CommandParameter="{Binding}"
                        Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Accept}" />
                <Button Grid.Column="2" Content="Decline" Style="{StaticResource SoftButtonStyle}" CommandParameter="{Binding}"
                        Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Decline}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Friends}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,6" Padding="12,8" ColumnSpacing="8" CornerRadius="{StaticResource ChipRadius}" Background="{StaticResource SurfaceRaisedBrush}"
                    AutomationProperties.Name="{Binding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Follow" Style="{StaticResource SoftButtonStyle}" IsEnabled="{Binding CanFollow}" CommandParameter="{Binding}"
                        Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Follow}" />
                <Button Grid.Column="2" Content="Remove" Style="{StaticResource QuietButtonStyle}" CommandParameter="{Binding}"
                        Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Remove}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Button Content="Shared sessions" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Sessions}" />
    </StackPanel>
  </ScrollViewer>
</Page>
