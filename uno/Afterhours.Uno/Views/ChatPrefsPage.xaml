<Page x:Class="Afterhours.Uno.Views.ChatPrefsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:conv="using:Afterhours.Uno.Converters"
      Background="{StaticResource SurfacePanelBrush}" Width="{utu:Responsive Narrowest=340, Narrow=420}">
  <!-- Chat preferences. Opened with !ChatPrefs (the chat column's gear). -->
  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="ShownWhen" />
  </Page.Resources>
  <StackPanel Padding="24" Spacing="12">
    <TextBlock Text="CHAT PREFERENCES" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
    <TextBlock Text="Make space for yourself" Style="{StaticResource TitleText}" />
    <CheckBox Content="Mute resident replies" IsChecked="{Binding Mute, Mode=TwoWay}" />
    <TextBlock Text="Resident characters are part of the solo world. Real connected guests appear with a live indicator."
               Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
    <Button Content="Save preferences" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Save}" />
    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,4" />
    <TextBlock Text="Blocked residents" Style="{StaticResource BodyStrongText}" />
    <TextBlock Text="Nobody is blocked." Style="{StaticResource CaptionText}" Visibility="{Binding NoneBlocked, Converter={StaticResource ShownWhen}}" />
    <ItemsControl ItemsSource="{Binding Blocked}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Margin="0,0,0,6" Style="{StaticResource SoftButtonStyle}" CommandParameter="{Binding}"
                  Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Unblock}">
            <TextBlock Style="{StaticResource BodyText}"><Run Text="Unblock " /><Run Text="{Binding}" /></TextBlock>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</Page>
