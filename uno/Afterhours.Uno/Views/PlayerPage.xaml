<Page x:Class="Afterhours.Uno.Views.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:conv="using:Afterhours.Uno.Converters"
      Background="{StaticResource SurfacePanelBrush}" Width="{utu:Responsive Narrowest=340, Narrow=440}">
  <!-- A connected player. Opened with !Player and a PlayerRequest(id) (a click on a player, the shared world). -->
  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="ShownWhen" />
    <conv:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />
  </Page.Resources>
  <StackPanel Padding="24" Spacing="12">
    <TextBlock Text="CONNECTED PLAYER" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
    <TextBlock Text="{Binding Player.Name}" Style="{StaticResource TitleText}" />
    <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding Error}" />

    <!-- Report, in place of the actions. -->
    <StackPanel Spacing="12" Visibility="{Binding Report.IsOpen, Converter={StaticResource ShownWhen}}">
      <TextBlock Text="Report a player" Style="{StaticResource BodyStrongText}" />
      <TextBlock Text="Tell us what happened. The report is stored for the world’s operator to review." Style="{StaticResource BodyText}"
                 TextWrapping="Wrap" TextTrimming="None" />
      <TextBox Header="Reason" Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Height="96"
               TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Reason" />
      <Button Content="Submit report" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SubmitReport}" />
    </StackPanel>

    <StackPanel Spacing="12" Visibility="{Binding Report.IsOpen, Converter={StaticResource HiddenWhen}}">
      <TextBlock Text="{Binding Player.Motto}" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
      <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
      <VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="44" ItemWidth="180">
        <Button Content="Add friend" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFriend}" Margin="0,0,6,6" HorizontalAlignment="Stretch" />
        <Button Content="Trade furniture" Style="{StaticResource SoftButtonStyle}" Command="{Binding Trade}" Margin="0,0,6,6" HorizontalAlignment="Stretch" />
        <Button Content="Whisper" Style="{StaticResource SoftButtonStyle}" Command="{Binding Whisper}" Margin="0,0,6,6" HorizontalAlignment="Stretch" />
        <Button Content="Block" Style="{StaticResource SoftButtonStyle}" Command="{Binding Block}" Margin="0,0,6,6" HorizontalAlignment="Stretch" />
        <Button Content="Report" Style="{StaticResource SoftButtonStyle}" Command="{Binding OpenReport}" Margin="0,0,6,6" HorizontalAlignment="Stretch" />
      </VariableSizedWrapGrid>
      <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding InOwnRoom, Converter={StaticResource ShownWhen}}">
        <Button Content="Remove from room" Style="{StaticResource SoftButtonStyle}" Command="{Binding Kick}" />
        <Button Content="Ban from room" Style="{StaticResource SoftButtonStyle}" Command="{Binding Ban}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Page>
