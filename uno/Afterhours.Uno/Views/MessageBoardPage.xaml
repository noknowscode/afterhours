<Page x:Class="Afterhours.Uno.Views.MessageBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{StaticResource SurfacePanelBrush}" Width="{utu:Responsive Narrowest=360, Narrow=520}">
  <!-- The room's notes. Opened with !MessageBoard (room tools or a notice board in the room). -->
  <ScrollViewer>
    <StackPanel Padding="24" Spacing="12">
      <TextBlock Text="MESSAGE BOARD" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
      <TextBlock Text="Leave a little something" Style="{StaticResource TitleText}" />
      <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding Error}" />
      <TextBox Header="Your note" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="180" Height="96"
               TextWrapping="Wrap" AcceptsReturn="True" PlaceholderText="A message for this room…" AutomationProperties.Name="Your note" />
      <Button Content="Pin note" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Pin}" />
      <ItemsControl ItemsSource="{Binding Notes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="150" ItemHeight="130" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,8,8" Padding="12,10" RowSpacing="6" CornerRadius="{StaticResource ChipRadius}" Background="{StaticResource SurfaceAccentTintBrush}">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
              <Grid Grid.Row="1">
                <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <Button Content="×" HorizontalAlignment="Right" Padding="8,0" Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="Remove note"
                        CommandParameter="{Binding}" Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Remove}" />
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
