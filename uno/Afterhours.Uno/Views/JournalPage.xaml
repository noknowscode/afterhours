<Page x:Class="Afterhours.Uno.Views.JournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:conv="using:Afterhours.Uno.Converters"
      Background="{StaticResource SurfacePanelBrush}" Width="{utu:Responsive Narrowest=360, Narrow=640}">
  <!-- The resident journal. Opened with !Journal and a JournalRequest(tab) (rail, daily gift, stage rewards). -->
  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="ShownWhen" />
    <conv:BoolToBrushConverter x:Key="EarnedInk" TrueBrush="{StaticResource AcidBrush}" FalseBrush="{StaticResource InkSoftBrush}" />
  </Page.Resources>
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="RESIDENT JOURNAL" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
      <TextBlock Text="Your night, your story" Style="{StaticResource TitleText}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
      <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding ShowTab}" CommandParameter="quests" AutomationProperties.Name="Quests">
        <StackPanel Spacing="4">
          <TextBlock Text="Quests" Style="{StaticResource BodyStrongText}" />
          <Rectangle Height="2" Fill="{StaticResource AcidBrush}" Visibility="{Binding Tabs.IsQuests, Converter={StaticResource ShownWhen}}" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding ShowTab}" CommandParameter="badges" AutomationProperties.Name="Badges">
        <StackPanel Spacing="4">
          <TextBlock Text="Badges" Style="{StaticResource BodyStrongText}" />
          <Rectangle Height="2" Fill="{StaticResource AcidBrush}" Visibility="{Binding Tabs.IsBadges, Converter={StaticResource ShownWhen}}" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding ShowTab}" CommandParameter="wallet" AutomationProperties.Name="Wallet">
        <StackPanel Spacing="4">
          <TextBlock Text="Wallet" Style="{StaticResource BodyStrongText}" />
          <Rectangle Height="2" Fill="{StaticResource AcidBrush}" Visibility="{Binding Tabs.IsWallet, Converter={StaticResource ShownWhen}}" />
        </StackPanel>
      </Button>
    </StackPanel>
    <InfoBar Grid.Row="2" IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding Error}" />

    <!-- Quests -->
    <ScrollViewer Grid.Row="3" Visibility="{Binding Tabs.IsQuests, Converter={StaticResource ShownWhen}}">
      <StackPanel Spacing="10">
        <TextBlock Text="A little direction for your night. Finish a quest, then collect its reward." Style="{StaticResource BodyText}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Quests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Padding="12" Margin="0,0,0,8" ColumnSpacing="12" CornerRadius="{StaticResource ChipRadius}" Background="{StaticResource SurfaceRaisedBrush}"
                    AutomationProperties.Name="{Binding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Mark}" FontSize="20" Foreground="{StaticResource AcidBrush}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                  <ProgressBar Value="{Binding Percent}" Maximum="100" Foreground="{StaticResource AcidBrush}" AutomationProperties.Name="Quest progress" />
                  <TextBlock Text="{Binding Counts}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding Action}" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanClaim}" CommandParameter="{Binding}"
                        Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.Claim}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Badges -->
    <ScrollViewer Grid.Row="3" Visibility="{Binding Tabs.IsBadges, Converter={StaticResource ShownWhen}}">
      <StackPanel Spacing="10">
        <TextBlock Text="Small keepsakes from nights well spent." Style="{StaticResource BodyText}" />
        <ItemsRepeater ItemsSource="{Binding Badges}">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="170" MinItemHeight="140" MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="Fill" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <StackPanel Padding="12" Spacing="4" CornerRadius="{StaticResource ChipRadius}" Background="{StaticResource SurfaceRaisedBrush}"
                          Opacity="{Binding Fade}" AutomationProperties.Name="{Binding}">
                <TextBlock Text="{Binding Icon}" FontSize="24" Foreground="{StaticResource AcidBrush}" />
                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Counts}" Style="{StaticResource CaptionText}" />
              </StackPanel>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollViewer>

    <!-- Wallet -->
    <ScrollViewer Grid.Row="3" Visibility="{Binding Tabs.IsWallet, Converter={StaticResource ShownWhen}}">
      <StackPanel Spacing="12">
        <StackPanel Padding="18" Spacing="2" CornerRadius="{StaticResource CardRadius}" Background="{StaticResource SurfaceAccentTintBrush}">
          <TextBlock Text="{Binding Coins}" Style="{StaticResource DisplayText}" />
          <TextBlock Text="Your credits · earned through play" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                   Text="Daily check-in: 35 credits. Stage: 40 credits for the first five performances each day. Arcade: up to 30 credits for the first eight rounds." />
        <ItemsControl ItemsSource="{Binding Ledger}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Padding="0,8" ColumnSpacing="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" AutomationProperties.Name="{Binding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Reason}" Style="{StaticResource BodyText}" />
                  <TextBlock Text="{Binding Date}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Amount}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center"
                           Foreground="{Binding Earned, Converter={StaticResource EarnedInk}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
